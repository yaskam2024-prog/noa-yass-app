{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "noa-yass-app",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "245f394f-fb38-436e-905b-e2d928a493b0","database_name": "DB" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "bb9b21a1c4e346288211eab3b3751d5c" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
